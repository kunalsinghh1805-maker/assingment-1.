// Question 6.
// Write a C# program to print all even and odd numbers between 1 and N, where N is entered
// by the user.

using System;

class Program
{
    static void Main()
    {
        Console.Write("Enter the value of N: ");
        int N = Convert.ToInt32(Console.ReadLine());
        Console.Write("\nEven Numbers:");
        for (int i = 1; i <= N; i++)
        {
            if (i % 2 == 0)
            {
                Console.Write(i + " ");
            }
        }
        Console.Write("\n\nOdd Numbers:");
        for (int i = 1; i <= N; i++)
        {
            if (i % 2 != 0)
            {
                Console.Write(i + " ");
            }
        }
    }
}
