//7.Write a C# program to calculate the factorial of a given positive integer using a for loop.

using System;

class Program
{
    static void Main()
    {
        Console.Write("Enter a positive integer: ");
        int n = Convert.ToInt32(Console.ReadLine());

        long factorial = 1;

        for (int i = 1; i <= n; i++)
        {
            factorial = factorial * i;
        }

        Console.WriteLine("Factorial of " + n + " is: " + factorial);
    }
}
